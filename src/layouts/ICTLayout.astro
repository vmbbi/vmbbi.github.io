---
import BaseLayout from "./BaseLayout.astro";

export interface Props {
  title: string;
  chapterNumber?: string;
  moduleName?: string;
}

const {
  title,
  chapterNumber,
  moduleName = "Information Processing",
} = Astro.props;
---

<BaseLayout pageTitle={title}>
  <div class="ict-wrapper max-w-5xl mx-auto px-4 py-6">
    <!-- ICT Breadcrumb Navigation -->
    <nav class="flex items-center gap-2 text-xs md:text-sm text-slate-400 mb-6 bg-slate-900/80 p-3 rounded-lg border border-slate-800">
      <a href="/" class="hover:text-cyan-400 transition">
        🏠 Home
      </a>
      <span>/</span>
      <a href="/ict" class="hover:text-cyan-400 transition">
        ICT Modules
      </a>
      {chapterNumber && (
        <>
          <span>/</span>
          <span class="text-cyan-400 font-mono font-semibold">
            Ch {chapterNumber}
          </span>
        </>
      )}
    </nav>

    <!-- Subchapter Header Banner -->
    <div class="mb-8 border-b border-slate-800 pb-6 flex flex-wrap items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <span class="px-3 py-1 bg-cyan-500/10 text-cyan-400 border border-cyan-500/30 text-xs font-mono rounded-full font-semibold uppercase">
          {moduleName}
        </span>
        {chapterNumber && (
          <span class="px-3 py-1 bg-amber-500/10 text-amber-400 border border-amber-500/30 text-xs font-mono rounded-full font-semibold">
            Chapter {chapterNumber}
          </span>
        )}
      </div>
    </div>

    <!-- Main Subchapter Content & Interactive Game Slot -->
    <div class="ict-content space-y-10">
      <slot />
    </div>
  </div>
</BaseLayout>
